# Copy to .env and fill in. .env is git-ignored; on Render set these as environment variables.
PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
PINECONE_API_KEY=
SLACK_BOT_TOKEN=
# Hard-to-guess URL segment; chat endpoint becomes /chat/<value>. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAT_PATH_SECRET=
# Optional bearer token callers must send to /chat
API_TOKEN=
# Optional: Pipedream Connect (enables gmail + pushover tools)
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_GMAIL_ACCOUNT_ID=
PIPEDREAM_PUSHOVER_ACCOUNT_ID=
